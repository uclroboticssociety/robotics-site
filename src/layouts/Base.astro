---
import "../styles/global.css";
import { Font } from "astro:assets";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "UCL Robotics Society",
  description = "A student-led robotics, AI and mechatronics society at UCL.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Browsers keep tab icons in their own long-lived store, keyed by URL, so
        a changed file at the same URL can show the old icon for months. When
        the logo changes, bump ?v= so every browser fetches it fresh, and run
        scripts/make_favicon.mjs to rebuild public/favicon.ico to match. */}
    <link rel="icon" href="/logo.svg?v=2" type="image/svg+xml" />
    <meta name="theme-color" content="#FBFAFF" />
    {/* Headings and body text are above the fold on every page, so preload them. */}
    <Font cssVariable="--font-redhat-display" preload />
    <Font cssVariable="--font-redhat-text" preload />
    <Font cssVariable="--font-redhat-mono" />
  </head>
  <body>
    <Navbar />
    <main><slot /></main>
    <Footer />
    <script>
      // Reveals anything marked [data-reveal] as it comes into view. Elements
      // are visible by default and this only adds [data-shown], so a failure
      // here costs the animation, not the content. Pages with nothing marked
      // pay for an empty querySelectorAll and nothing else.
      //
      // rootMargin rather than a threshold: a section taller than the viewport
      // can never reach, say, threshold 0.15, but its top always crosses 85%
      // of the viewport height.
      //
      // [data-reveal-stagger] goes on a group (a grid or a list) instead: each
      // of its children is watched separately. Children that come into view
      // at the same moment (one row of a grid) are numbered 0, 1, 2... in
      // --i, and the CSS turns that number into a delay so they arrive one
      // after another.
      const revealables = document.querySelectorAll<HTMLElement>(
        "[data-reveal], [data-reveal-stagger] > *"
      );

      if (revealables.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            let order = 0;
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              if (el.parentElement?.hasAttribute("data-reveal-stagger")) {
                el.style.setProperty("--i", String(order++));
              }
              el.setAttribute("data-shown", "");
              // Reveal once. Re-animating on every scroll past is what makes
              // this kind of thing feel cheap.
              observer.unobserve(el);
            });
          },
          { rootMargin: "0px 0px -15% 0px" }
        );

        revealables.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
