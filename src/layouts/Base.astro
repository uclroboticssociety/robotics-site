---
import "../styles/global.css";
import { Font } from "astro:assets";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "UCL Robotics Society",
  description = "A student-led robotics, AI and mechatronics society at UCL.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.png" />
    <meta name="theme-color" content="#0C0F12" />
    {/* Display weights are used above the fold on every page, so preload them. */}
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-spline-mono" />
  </head>
  <body>
    <Navbar />
    <main><slot /></main>
    <Footer />
  </body>
</html>
