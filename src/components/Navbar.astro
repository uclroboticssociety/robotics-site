---
import Brand from "./nav/Brand.astro";
import DesktopNav from "./nav/DesktopNav.astro";
import MobileNav from "./nav/MobileNav.astro";
import Container from "./ui/Container.astro";
import { menu } from "../data/nav";

const { pathname } = Astro.url;
---

<nav class="site-nav">
  <Container class="nav-in">
    <Brand />
    <DesktopNav items={menu} pathname={pathname} />
    <MobileNav items={menu} pathname={pathname} />
  </Container>
</nav>
