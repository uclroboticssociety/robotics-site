---
import Container from "../ui/Container.astro";
import type { EventInitiative } from "../../data/events";

/**
 * Shared sidebar shell for the events and projects sections.
 *
 * The categories are native <details> elements so they work without JS; the
 * script below only enforces single-open behaviour, which members are used to.
 */
type Props = {
  initiatives: EventInitiative[];
  /** Heading above the category panel. Projects pass their own. */
  sidebarTitle?: string;
  currentId?: EventInitiative["id"];
  recentByInitiative?: Partial<
    Record<EventInitiative["id"], { title: string; href: string }[]>
  >;
  currentEventHref?: string;
};

const {
  initiatives,
  sidebarTitle = "Explore events",
  currentId,
  recentByInitiative = {},
  currentEventHref,
} = Astro.props;
---

<Container>
  <div class="with-side" data-events-accordion>
    <aside class="side">
      <h2 class="mono">{sidebarTitle}</h2>
      <div class="side-panel">
        {
          initiatives.map((initiative) => {
            const entries = recentByInitiative[initiative.id] ?? [];
            return (
              <details open={initiative.id === currentId} data-current={initiative.id === currentId ? "" : null}>
                <summary>
                  {initiative.title}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                {entries.length ? (
                  <div class="side-links">
                    {entries.map((entry) => (
                      <a
                        href={entry.href}
                        aria-current={entry.href === currentEventHref ? "page" : undefined}
                      >
                        {entry.title}
                      </a>
                    ))}
                  </div>
                ) : (
                  <p class="side-empty">Nothing here yet.</p>
                )}
              </details>
            );
          })
        }
      </div>
    </aside>

    <div>
      <slot />
    </div>
  </div>
</Container>

<script>
  const root = document.querySelector("[data-events-accordion]");
  if (root) {
    const items = Array.from(root.querySelectorAll("details"));
    items.forEach((item) => {
      item.addEventListener("toggle", () => {
        if (!item.open) return;
        items.forEach((other) => {
          if (other !== item) other.open = false;
        });
      });
    });
  }
</script>
