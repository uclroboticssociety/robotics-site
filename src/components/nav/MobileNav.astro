---
import type { Item } from "../../data/nav";
import { joinLink } from "../../data/nav";

const { items, pathname } = Astro.props as {
  items: Item[];
  pathname: string;
};

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<button
  type="button"
  class="nav-toggle"
  id="navToggle"
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="navDrawer"
>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
  </svg>
</button>

<div class="nav-drawer" id="navDrawer">
  <div class="wrap">
    {
      items.map((item, i) =>
        item.children ? (
          <div>
            <button
              type="button"
              class="acc-toggle"
              aria-expanded="false"
              aria-controls={`drawer-acc-${i}`}
            >
              {item.label}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="acc-panel" id={`drawer-acc-${i}`}>
              {item.children.map((c) => (
                <a href={c.href} aria-current={isActive(c.href) ? "page" : undefined}>
                  {c.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        )
      )
    }
    <div class="acts">
      <a class="btn" href={joinLink.href}>{joinLink.label}</a>
    </div>
  </div>
</div>

<script>
  const toggle = document.getElementById("navToggle");
  const drawer = document.getElementById("navDrawer");

  if (toggle && drawer) {
    const focusables = () =>
      Array.from(
        drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
      ).filter((el) => el.offsetParent !== null);

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      if (open) drawer.setAttribute("data-open", "");
      else drawer.removeAttribute("data-open");
    };

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    toggle.addEventListener("click", () => {
      const next = !isOpen();
      setOpen(next);
      if (next) focusables()[0]?.focus();
    });

    // Escape closes and returns focus to the trigger.
    document.addEventListener("keydown", (event) => {
      if (!isOpen()) return;

      if (event.key === "Escape") {
        setOpen(false);
        toggle.focus();
        return;
      }

      // Keep Tab inside the drawer while it is open.
      if (event.key === "Tab") {
        const items = [toggle, ...focusables()];
        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement;

        if (event.shiftKey && active === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && active === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    // A resize past the breakpoint should not leave a hidden drawer "open".
    const wide = window.matchMedia("(min-width: 1001px)");
    wide.addEventListener("change", (event) => {
      if (event.matches && isOpen()) setOpen(false);
    });

    drawer.querySelectorAll<HTMLButtonElement>(".acc-toggle").forEach((button) => {
      const id = button.getAttribute("aria-controls");
      const panel = id ? document.getElementById(id) : null;
      if (!panel) return;

      button.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!open));
        if (open) panel.removeAttribute("data-open");
        else panel.setAttribute("data-open", "");
      });
    });
  }
</script>
