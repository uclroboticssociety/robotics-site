---
import type { Item } from "../../data/nav";
import { joinLink } from "../../data/nav";

const { items, pathname } = Astro.props as {
  items: Item[];
  pathname: string;
};

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

// A parent is "current" when it or any of its children matches the URL.
const isCurrentBranch = (item: Item) =>
  isActive(item.href) || (item.children ?? []).some((c) => isActive(c.href));
---

<div class="nav-links">
  {
    items.map((item, i) =>
      item.children ? (
        <div class="nav-menu" data-nav-menu data-current={isCurrentBranch(item) ? "" : null}>
          <button type="button" aria-expanded="false" aria-controls={`nav-panel-${i}`}>
            {item.label}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="nav-panel" id={`nav-panel-${i}`}>
            {item.children.map((c) => (
              <a href={c.href} aria-current={isActive(c.href) ? "page" : undefined}>
                {c.label}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      )
    )
  }
  <a class="btn" href={joinLink.href}>{joinLink.label}</a>
</div>

<script>
  // Dropdowns open on hover and on click/keyboard, and aria-expanded always
  // reflects the real state (the previous implementation hardcoded "false").
  const menus = document.querySelectorAll<HTMLElement>("[data-nav-menu]");

  menus.forEach((menu) => {
    const trigger = menu.querySelector<HTMLButtonElement>("button");
    const panel = menu.querySelector<HTMLElement>(".nav-panel");
    if (!trigger || !panel) return;

    const setOpen = (open: boolean) => {
      trigger.setAttribute("aria-expanded", String(open));
      if (open) panel.setAttribute("data-open", "");
      else panel.removeAttribute("data-open");
    };

    menu.addEventListener("mouseenter", () => setOpen(true));
    menu.addEventListener("mouseleave", () => setOpen(false));
    trigger.addEventListener("click", () =>
      setOpen(trigger.getAttribute("aria-expanded") !== "true")
    );

    // Close when focus leaves the menu entirely, so tabbing past it tidies up.
    menu.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (!next || !menu.contains(next)) setOpen(false);
    });

    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setOpen(false);
        trigger.focus();
      }
    });
  });
</script>
