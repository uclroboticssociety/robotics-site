---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import EventsLayout from "../components/events/EventsLayout.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import EventRow from "../components/ui/EventRow.astro";
import JoinCTA from "../components/ui/JoinCTA.astro";
import Container from "../components/ui/Container.astro";
import { initiatives } from "../data/events";
import { byDateDesc, folderOf } from "../lib/events";

const allEvents = await getCollection("events");
const sorted = [...allEvents].sort(byDateDesc);

// The sidebar label uses the folder name, which is also the URL, so the two
// always agree. See docs/CONTENT_GUIDE.md.
const listFor = (tag: string) =>
  sorted
    .filter((event) => event.data.tags?.includes(tag))
    .map((event) => ({ title: folderOf(event), href: `/events/${event.id}` }));

const recentByInitiative = Object.fromEntries(
  initiatives.map((initiative) => [initiative.id, listFor(initiative.tag)])
);
---

<Base
  title="Events | UCL Robotics Society"
  description="Workshops, hackathons, challenges and socials run by the UCL Robotics Society."
>
  <PageHeader
    title="Events"
    eyebrow="What's on"
    lede="Workshops, hackathons, challenges and socials, open to every UCL student."
    rule={false}
  />

  <EventsLayout initiatives={initiatives} recentByInitiative={recentByInitiative}>
    <SectionHeader title="All events" meta={`${sorted.length} events`} />
    {
      sorted.length ? (
        <div class="rows">
          {sorted.map((event) => (
            <EventRow event={event} />
          ))}
        </div>
      ) : (
        <p class="lede">No events announced yet.</p>
      )
    }
  </EventsLayout>

  <Container>
    <JoinCTA />
  </Container>
</Base>
