---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";

const membershipUrl = "https://studentsunionucl.org/clubs-societies/robotics-society";

const included = [
  {
    title: "Workshops and taster sessions",
    body: "Hands-on sessions across the robotics stack, from electronics and CAD to control and AI. No prior experience needed.",
  },
  {
    title: "Projects",
    body: "Team-based builds you can join at any level, running through the year.",
  },
  {
    title: "Socials",
    body: "Film nights, board games and bowling — the society is a community, not just a lab.",
  },
  {
    title: "Equipment, space and training",
    body: "Your membership fee supports the hardware, space and training sessions that keep activities affordable for everyone.",
  },
];
---

<Base
  title="Join Us | UCL Robotics Society"
  description="Membership of the UCL Robotics Society is open to all UCL students and affiliates."
>
  <PageHeader
    title="Membership"
    eyebrow="Join us"
    lede="Open to all UCL students and affiliates, whatever your background or experience."
  />

  <Container>
    <section class="section" style="padding-top:48px">
      <div class="prose-body">
        <p>
          Our membership is available to all UCL students and affiliates. It includes access to
          workshops, socials, and projects throughout the year, plus opportunities to learn new tools
          and collaborate with peers across disciplines. Your membership fee supports equipment,
          space, and training sessions, while keeping activities affordable for everyone.
        </p>
        <p>
          New to robotics? Try our taster sessions first and join when you're ready. Membership can
          be obtained via the Students' Union website. Email us at
          <a href="mailto:robosoc@ucl.ac.uk">robosoc@ucl.ac.uk</a> if you have any questions.
        </p>
      </div>

      <div class="acts">
        <a class="btn" href={membershipUrl} target="_blank" rel="noreferrer">Buy membership</a>
        <a class="btn btn-o" href="/events">See what's on</a>
      </div>
    </section>

    <section class="section">
      <SectionHeader title="What's included" />
      <div class="rule-list">
        {
          included.map((item) => (
            <div>
              <h3>{item.title}</h3>
              <p style="color:var(--color-muted);margin:8px 0 0;max-width:60ch">{item.body}</p>
            </div>
          ))
        }
      </div>
    </section>
  </Container>
</Base>
