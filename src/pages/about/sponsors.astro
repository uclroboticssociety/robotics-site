---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { asset } from "../../lib/assets";
import PageHeader from "../../components/ui/PageHeader.astro";
import Container from "../../components/ui/Container.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import { sponsors } from "../../data/sponsors";
---

<Base
  title="Sponsors | UCL Robotics Society"
  description="Organisations supporting the UCL Robotics Society."
>
  <PageHeader
    title="Our sponsors"
    eyebrow="Partners"
    lede="Our partners help us keep workshops, hardware and events open to every UCL student."
  />

  <Container>
    <section class="section" style="padding-top:48px">
      {
        sponsors.length ? (
          <div class="sponsors">
            {
              sponsors.map((sponsor) => {
                const logo = asset(sponsor.logo);
                if (!logo) return null;
                /* alt is empty until the committee supplies real names — an
                   invented name would be worse than none. See data/sponsors.ts */
                const img = (
                  <Image class="logo-img" src={logo} alt={sponsor.name} widths={[180, 280]} loading="lazy" />
                );
                return sponsor.url ? <a href={sponsor.url}>{img}</a> : img;
              })
            }
          </div>
        ) : (
          <p class="lede">We're looking for our first partners.</p>
        )
      }
    </section>

    <section class="section">
      <SectionHeader title="Partner with us" />
      <div class="prose-body">
        <p>
          Sponsoring the society puts your organisation in front of students building real robotic
          systems — through workshops, hardware, event branding and direct recruitment.
        </p>
        <p>
          To talk about sponsorship, email us at
          <a href="mailto:robosoc@ucl.ac.uk">robosoc@ucl.ac.uk</a>.
        </p>
      </div>
      <div class="acts">
        <a class="btn" href="mailto:robosoc@ucl.ac.uk">Get in touch</a>
        <a class="btn btn-o" href="/contact">Contact page</a>
      </div>
    </section>
  </Container>
</Base>
