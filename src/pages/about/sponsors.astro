---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { asset } from "../../lib/assets";
import PageHeader from "../../components/ui/PageHeader.astro";
import Container from "../../components/ui/Container.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import { sponsors } from "../../data/sponsors";
import { site } from "../../data/site";

// Sponsors whose logo file exists. Logos come in very different shapes, so one
// fixed height makes a wide wordmark look tiny next to a compact one. Scaling
// the height by 1/sqrt(aspect ratio) gives every logo roughly the same area,
// which is what the eye reads as "the same size".
const plates = sponsors.flatMap((sponsor) => {
  const logo = asset(sponsor.logo);
  if (!logo) return [];
  return [
    {
      ...sponsor,
      logo,
      height: Math.round(140 / Math.sqrt(logo.width / logo.height)),
      // "https://www.mathworks.com" -> "mathworks.com"
      domain: sponsor.url && new URL(sponsor.url).hostname.replace(/^www\./, ""),
      Tag: sponsor.url ? "a" : "div",
    },
  ];
});
---

<Base
  title="Sponsors | UCL Robotics Society"
  description="Organisations supporting the UCL Robotics Society."
>
  <PageHeader
    title="Our sponsors"
    eyebrow="Partners"
    lede="Our partners help us keep workshops, hardware and events open to every UCL student."
  />

  <Container>
    <section class="section" style="padding-top:56px">
      {
        plates.length ? (
          <div class="sponsor-plate">
            {plates.map(({ Tag, name, logo, height, url, domain }) => (
              <Tag class="sponsor" href={url} target={url && "_blank"} rel={url && "noopener"}>
                <span class="sponsor-mark">
                  <Image src={logo} alt={name} widths={[280, 560]} sizes="280px" style={`height:${height}px`} loading="lazy" />
                </span>
                {domain && (
                  <span class="mono sponsor-site">
                    {domain} <span class="sponsor-arrow" aria-hidden="true">↗</span>
                  </span>
                )}
              </Tag>
            ))}
          </div>
        ) : (
          <p class="lede">We're looking for our first partners.</p>
        )
      }
    </section>

    <section class="section">
      <SectionHeader title="Partner with us" />
      <div class="prose-body">
        <p>
          Sponsoring the society puts your organisation in front of students building real robotic
          systems - through workshops, hardware, event branding and direct recruitment.
        </p>
        <p>
          To talk about sponsorship, email us at <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
        </p>
      </div>
      <div class="acts">
        <a class="btn" href={`mailto:${site.contactEmail}`}>Get in touch</a>
        <a class="btn btn-o" href="/contact">Contact page</a>
      </div>
    </section>
  </Container>
</Base>
