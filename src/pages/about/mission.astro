---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import Container from "../../components/ui/Container.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import JoinCTA from "../../components/ui/JoinCTA.astro";
import { asset } from "../../lib/assets";

/**
 * "Who we are for" was previously three CSS flip cards. The content on the back
 * of each card was unreachable by keyboard and invisible to screen readers, so
 * the cards are now static: same copy, no hover-to-reveal.
 */
const audiences = [
  {
    image: "mission/3.png",
    title: "Beginners and explorers",
    body: "New to robotics or unsure where to start? We provide beginner-friendly workshops, guided projects, and a supportive environment to help you build confidence from the ground up.",
  },
  {
    image: "mission/4.png",
    title: "Builders and engineers",
    body: "For students who want to get hands-on. Work on real robotic systems, team-based projects, and competitions that span hardware, control, perception, and AI.",
  },
  {
    image: "mission/5.png",
    title: "Researchers and innovators",
    body: "Interested in advanced robotics, AI, or research-led projects? We support deeper exploration through research-oriented initiatives, collaborations, and industry exposure.",
  },
];
---

<Base
  title="Mission | UCL Robotics Society"
  description="Why the UCL Robotics Society exists and what we do."
>
  <PageHeader
    title="Mission"
    eyebrow="About"
    lede="A student-led community dedicated to fostering innovation, collaboration and learning in robotics, artificial intelligence and mechatronics."
  />

  <Container>
    <section class="section" style="padding-top:48px">
      <div class="about">
        <div>
          <p class="big">
            We provide a platform for students of all backgrounds to explore, build and compete in
            the exciting world of robotics.
          </p>
          <p>
            Robotics sits at the intersection of hardware, software, and intelligence, yet many
            students lack access to meaningful hands-on experience, interdisciplinary collaboration,
            and real-world problem solving.
          </p>
          <p>
            The Robotics Society bridges this gap by fostering an open, student-driven community
            where theory becomes practice. We lower the barrier to building and experimentation,
            empowering students from diverse backgrounds to explore robotics beyond the classroom.
          </p>
        </div>
        <figure class="duo">
          {
            asset("mission/1.png") && (
              <Image
                src={asset("mission/1.png")!}
                alt="Members building a robot together at a society workshop"
                widths={[480, 720, 960]}
                sizes="(max-width: 1000px) 100vw, 45vw"
                loading="lazy"
                decoding="async"
              />
            )
          }
        </figure>
      </div>
    </section>

    <section class="section">
      <SectionHeader title="What we do" />
      <div class="about">
        <figure class="duo">
          {
            asset("mission/2.png") && (
              <Image
                src={asset("mission/2.png")!}
                alt="Students testing a robot during a society session"
                widths={[480, 720, 960]}
                sizes="(max-width: 1000px) 100vw, 45vw"
                loading="lazy"
                decoding="async"
              />
            )
          }
        </figure>
        <div>
          <p>
            We design hands-on projects and workshops spanning the full robotics stack - from
            mechanical design and electronics to perception, control, and AI. Through project-based
            learning, industry talks, hackathons, and cross-disciplinary collaboration, members gain
            practical skills, research exposure, and engineering confidence.
          </p>
          <p>
            Whether you're new to robotics or building advanced systems, we provide the platform,
            resources, and community to support your growth.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <SectionHeader title="Who we are for" />
      <p class="lede" style="margin-top:0;margin-bottom:30px;max-width:60ch">
        The Robotics Society is open to anyone curious about building intelligent machines -
        regardless of background or experience. Whether you're just getting started or aiming for
        cutting-edge research and industry roles, there's a place for you here.
      </p>
      <div class="g3">
        {
          audiences.map((audience) => (
            <article class="card">
              <Image
                class="shot"
                src={asset(audience.image)!}
                alt=""
                widths={[400, 600, 800]}
                sizes="(max-width: 1000px) 100vw, 33vw"
                loading="lazy"
                decoding="async"
              />
              <div class="p">
                <h3>{audience.title}</h3>
                <p>{audience.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <JoinCTA />
  </Container>
</Base>
