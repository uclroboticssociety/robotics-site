---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";

// These were placeholders (your_handle, your-org, your_invite). They are now
// the society's real accounts, taken from the footer. GitHub is omitted
// because there is no known society organisation to point at.
const socials = [
  {
    name: "Instagram",
    href: "https://www.instagram.com/ucl.robotics?igsh=MWNneW8wZWh1ZzZkaA%3D%3D&utm_source=qr",
  },
  { name: "LinkedIn", href: "https://www.linkedin.com/company/robotics-society-ucl/" },
  { name: "WhatsApp", href: "https://chat.whatsapp.com/EH3n4x6V9UbAE2nXjzz1IT" },
];

const email = "robosoc@ucl.ac.uk";

// TODO (committee): both forms still post to the placeholder endpoint that
// shipped with the original page, so submissions go nowhere. Replace it with
// your own FormSubmit or Formspree endpoint (e.g. https://formsubmit.co/<your
// address>) and delete this note. Until then the email link below is the only
// route that actually reaches you, which is why it is shown next to the form.
const FORM_ENDPOINT = "https://formsubmit.co/your@email.com";
---

<Base
  title="Contact | UCL Robotics Society"
  description="Get in touch with the UCL Robotics Society about collaborations, sponsorship or general enquiries."
>
  <PageHeader
    title="Contact"
    eyebrow="Get in touch"
    lede="For collaborations, sponsorship or general enquiries."
  />

  <Container>
    <section class="section" style="padding-top:48px">
      <div class="g3">
        <article class="panel">
          <h2 class="mono">Email</h2>
          <p>Our official inbox, monitored by the committee.</p>
          <a class="quiet-link" href={`mailto:${email}`}>{email}</a>
        </article>

        <article class="panel">
          <h2 class="mono">Socials</h2>
          <ul class="plain">
            {
              socials.map((social) => (
                <li>
                  <a class="quiet-link" href={social.href} target="_blank" rel="noopener">
                    {social.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </article>

        <article class="panel">
          <h2 class="mono">Community</h2>
          <p>Join the group chat to hear about sessions first.</p>
          <div class="acts" style="margin-top:16px">
            <a
              class="btn btn-o"
              href="https://chat.whatsapp.com/EH3n4x6V9UbAE2nXjzz1IT"
              target="_blank"
              rel="noopener">WhatsApp group</a
            >
          </div>
        </article>
      </div>
    </section>

    <section class="section">
      <SectionHeader title="Send us a message" />
      <div class="g2">
        <form class="panel" method="POST" action={FORM_ENDPOINT} novalidate data-validate>
          <label class="field">
            <span class="label">Name</span>
            <input class="input" type="text" name="name" required autocomplete="name" />
            <span class="error" data-error hidden>Please tell us your name.</span>
          </label>

          <label class="field">
            <span class="label">Email</span>
            <input class="input" type="email" name="email" required autocomplete="email" />
            <span class="error" data-error hidden>Please enter an email address we can reply to.</span>
          </label>

          <label class="field">
            <span class="label">Message</span>
            <textarea class="input" name="message" rows="5" required></textarea>
            <span class="error" data-error hidden>Please include a message.</span>
          </label>

          <input type="hidden" name="_next" value="/contact?success=1" />
          <button class="btn" type="submit">Send message</button>
          <p class="help">
            Prefer email? Write to <a href={`mailto:${email}`}>{email}</a>.
          </p>
        </form>

        <div class="panel" id="newsletter">
          <h2 class="mono">Newsletter</h2>
          <p>Event reminders and project updates, a few times a term.</p>
          <form method="POST" action={FORM_ENDPOINT} style="margin-top:18px" data-validate novalidate>
            <input type="hidden" name="_subject" value="[Robotics] Newsletter subscription" />
            <label class="field">
              <span class="label">Email</span>
              <input class="input" type="email" name="email" placeholder="you@ucl.ac.uk" required autocomplete="email" />
              <span class="error" data-error hidden>Please enter a valid email address.</span>
            </label>
            <button class="btn btn-o" type="submit">Subscribe</button>
          </form>
        </div>
      </div>
    </section>
  </Container>
</Base>

<script>
  // Inline, per-field error messages in the warn tone. Native validation still
  // does the checking; this only decides where the message appears, so the
  // form keeps working with JavaScript disabled.
  document.querySelectorAll<HTMLFormElement>("form[data-validate]").forEach((form) => {
    const fieldOf = (control: Element) => control.closest(".field");

    const showError = (control: HTMLInputElement | HTMLTextAreaElement) => {
      const field = fieldOf(control);
      const error = field?.querySelector<HTMLElement>("[data-error]");
      if (!field || !error) return;
      field.classList.add("field-error");
      error.hidden = false;
      control.setAttribute("aria-invalid", "true");
    };

    const clearError = (control: HTMLInputElement | HTMLTextAreaElement) => {
      const field = fieldOf(control);
      const error = field?.querySelector<HTMLElement>("[data-error]");
      if (!field || !error) return;
      field.classList.remove("field-error");
      error.hidden = true;
      control.removeAttribute("aria-invalid");
    };

    const controls = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea")
    );

    controls.forEach((control) => {
      control.addEventListener("input", () => {
        if (control.checkValidity()) clearError(control);
      });
    });

    form.addEventListener("submit", (event) => {
      let firstInvalid: HTMLInputElement | HTMLTextAreaElement | undefined;

      controls.forEach((control) => {
        if (control.checkValidity()) {
          clearError(control);
        } else {
          showError(control);
          firstInvalid = firstInvalid ?? control;
        }
      });

      if (firstInvalid) {
        event.preventDefault();
        firstInvalid.focus();
      }
    });
  });
</script>
