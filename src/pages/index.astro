---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Container from "../components/ui/Container.astro";
import ArmCanvas from "../components/ui/ArmCanvas.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import NextEvent from "../components/ui/NextEvent.astro";
import EventRow from "../components/ui/EventRow.astro";
import ProjectCard from "../components/ui/ProjectCard.astro";
import MemberTile from "../components/ui/MemberTile.astro";
import JoinCTA from "../components/ui/JoinCTA.astro";
import { committee } from "../data/committee";
import { statusPillText } from "../data/site";
import { byDateDesc, mostRecentEvent, nextEvent } from "../lib/events";
import { coverOf } from "../lib/projects";

const allEvents = await getCollection("events");
const allProjects = await getCollection("projects");

// Featured panel: the soonest future event if there is one, otherwise the most
// recent past event as a recap. Adding a future-dated event switches this over
// on the next build with no code change.
const upcoming = nextEvent(allEvents);
const featured = upcoming ?? mostRecentEvent(allEvents);

const recentEvents = [...allEvents].sort(byDateDesc).slice(0, 5);
const featuredCommittee = committee.slice(0, 8);
---

<Base
  title="UCL Robotics Society"
  description="A student-led community for robotics, AI and mechatronics at UCL. Workshops, hackathons, challenges and projects, open to every student."
>
  <div class="hero">
    <ArmCanvas />
    <Container>
      <div class="hero-in">
        <span class="pill rise d1"><i aria-hidden="true"></i> {statusPillText()}</span>
        <h1 class="rise d2">Where UCL builds <em class="grad">things that move</em>.</h1>
        <p class="lede rise d3">
          A student-led community for robotics, AI and mechatronics. We prototype, compete, and
          share the thrill of real-world engineering.
        </p>
        <div class="acts rise d4">
          <a class="btn" href="/join">Join the society</a>
          <a class="btn btn-o" href="/events">See what's on</a>
          <a class="btn btn-quiet" href="/about/sponsors">Partner with us →</a>
        </div>
      </div>
    </Container>
  </div>

  <Container>
    {
      featured && (
        <section class="section" style="padding-top:44px">
          <SectionHeader
            title={upcoming ? "Next event" : "Most recent event"}
            meta={upcoming ? undefined : "No upcoming events announced"}
            linkHref={upcoming ? "/events" : undefined}
            linkLabel={upcoming ? "All events →" : undefined}
          />
          <NextEvent event={featured} upcoming={Boolean(upcoming)} />
        </section>
      )
    }

    <section class="section">
      <SectionHeader title="About the society" linkHref="/about/mission" linkLabel="Read our mission →" />
      <div class="about">
        <div>
          <p class="big">
            A student-led community dedicated to fostering innovation, collaboration and learning in
            robotics, artificial intelligence and mechatronics.
          </p>
          <p>
            We provide a platform for students of all backgrounds to explore, build and compete in
            the exciting world of robotics.
          </p>
          <p>
            Robotics sits at the intersection of hardware, software and intelligence, yet many
            students lack access to meaningful hands-on experience, interdisciplinary collaboration
            and real-world problem solving. We exist to bridge that gap.
          </p>
        </div>
        <figure class="duo">
          <img src="/mission/1.png" alt="Society members working together on a robotics build" width="2028" height="1365" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <section class="section">
      <SectionHeader title="Committee" linkHref="/about/committee" linkLabel="Meet the full team →" />
      <div class="team">
        {featuredCommittee.map((member) => <MemberTile name={member.name} role={member.role} photo={member.photo} />)}
      </div>
    </section>

    <section class="section">
      <SectionHeader title="What's on" linkHref="/events" linkLabel="All events →" />
      <div class="rows">
        {recentEvents.map((event) => <EventRow event={event} />)}
      </div>
    </section>

    <section class="section">
      <SectionHeader title="Projects" linkHref="/projects" linkLabel="All projects →" />
      <div class="g2">
        {
          allProjects.map((project) => (
            <ProjectCard
              href={`/projects/${project.id}`}
              title={project.data.title}
              summary={project.data.summary}
              attribution={project.data.lead ? `Lead — ${project.data.lead}` : undefined}
              image={coverOf(project)}
            />
          ))
        }
      </div>
    </section>

    <JoinCTA />
  </Container>
</Base>
