---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Container from "../components/ui/Container.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import NextEvent from "../components/ui/NextEvent.astro";
import EventRow from "../components/ui/EventRow.astro";
import ProjectCard from "../components/ui/ProjectCard.astro";
import MemberTile from "../components/ui/MemberTile.astro";
import JoinCTA from "../components/ui/JoinCTA.astro";
import HeroNetwork from "../components/ui/HeroNetwork.astro";
import { committee } from "../data/committee";
import { statusPillText } from "../data/site";
import { byDateAsc, byDateDesc, mostRecentEvent, statusOf } from "../lib/events";
import { coverOf } from "../lib/projects";
import { asset } from "../lib/assets";

const allEvents = await getCollection("events");
const allProjects = await getCollection("projects");

// Featured panel: the soonest event that is today or still ahead, otherwise the
// most recent past event as a recap.
//
// The site is only rebuilt when someone pushes, so choosing once at build time
// would leave a finished event labelled "Next event" until the next push. So
// every event still ahead at build time gets two panels, one upcoming and one
// recap, and the script at the bottom of this page shows whichever is right on
// the day someone visits. Without JavaScript, the build-time choice shows.
const upcomingEvents = allEvents.filter((event) => statusOf(event) !== "past").sort(byDateAsc);
const lastPastEvent = mostRecentEvent(allEvents.filter((event) => statusOf(event) === "past"));
const recapEvents = lastPastEvent ? [lastPastEvent, ...upcomingEvents] : upcomingEvents;
const featuredPanels = [
  ...upcomingEvents.map((event) => ({ event, upcoming: true })),
  ...recapEvents.map((event) => ({ event, upcoming: false })),
];

const recentEvents = [...allEvents].sort(byDateDesc).slice(0, 5);
const featuredCommittee = committee;
const heroPhoto = asset("mission/2.png");
const missionPhoto = asset("mission/1.png");
---

<Base
  title="UCL Robotics Society"
  description="A student-led community for robotics, AI and mechatronics at UCL. Workshops, hackathons, challenges and projects, open to every student."
>
  <div class="hero">
    <HeroNetwork />
    <Container class="wrap-wide">
      <div class="hero-grid">
        <div class="hero-in">
          <span class="mono rise d1">{statusPillText()}</span>
          {/* The spans only control the line break (.nb) and colour two words
              (.hl); the words are unchanged. */}
          <h1 class="rise d2">Experience the heart <span class="nb">of <span class="hl">UCL innovation</span></span></h1>
          <p class="lede rise d3">
            A student-led community for robotics, AI and mechatronics. We prototype, compete, and
            share the thrill of real-world engineering.
          </p>
          <div class="acts rise d4">
            <a class="btn" href="/join">Join the society</a>
            <a class="btn btn-o" href="/events">See what's on</a>
            <a class="btn btn-o" href="/about/sponsors">Partner with us</a>
          </div>
        </div>
        {
          heroPhoto && (
            <figure class="hero-frame">
              <Image
                src={heroPhoto}
                alt="Society members working on a robotics build"
                widths={[480, 720, 960, 1200]}
                sizes="(max-width: 1000px) 92vw, 45vw"
                loading="eager"
                decoding="async"
              />
            </figure>
          )
        }
      </div>
    </Container>
    <a class="hero-scroll" href="#after-hero" aria-label="Scroll to content">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </a>
  </div>
  <div id="after-hero"></div>

  <Container>
    {
      featuredPanels.map(({ event, upcoming }, i) => (
        <section
          class="section"
          style="padding-top:44px"
          data-featured={upcoming ? "upcoming" : "recap"}
          data-date={event.data.date}
          hidden={i !== 0}
        >
          <SectionHeader
            title={upcoming ? "Next event" : "Most recent event"}
            meta={upcoming ? undefined : "No upcoming events announced"}
            linkHref={upcoming ? "/events" : undefined}
            linkLabel={upcoming ? "All events →" : undefined}
          />
          <NextEvent event={event} upcoming={upcoming} />
        </section>
      ))
    }

    {/* One reveal per section, below the fold only — see docs/DESIGN.md §6. */}
    <section class="section" data-reveal>
      <SectionHeader title="Our story" linkHref="/about/mission" linkLabel="Read our mission →" />
      <div class="about">
        <div>
          <p class="big">
            A student-led community dedicated to fostering innovation, collaboration and learning in
            robotics, artificial intelligence and mechatronics.
          </p>
          <p>
            We provide a platform for students of all backgrounds to explore, build and compete in
            the exciting world of robotics.
          </p>
          <p>
            Robotics sits at the intersection of hardware, software and intelligence, yet many
            students lack access to meaningful hands-on experience, interdisciplinary collaboration
            and real-world problem solving. We exist to bridge that gap.
          </p>
        </div>
        <figure class="duo">
          {
            missionPhoto && (
              <Image
                src={missionPhoto}
                alt="Society members working together on a robotics build"
                widths={[480, 720, 960]}
                sizes="(max-width: 1000px) 100vw, 45vw"
                loading="lazy"
                decoding="async"
              />
            )
          }
        </figure>
      </div>
    </section>

    {/* These two sections stagger their items in instead of rising as a block. */}
    <section class="section">
      <SectionHeader title="Committee" linkHref="/about/committee" linkLabel="Meet the full team →" />
      <div class="team team-3" data-reveal-stagger>
        {featuredCommittee.map((member) => <MemberTile name={member.name} role={member.role} photo={member.photo} linkedin={member.linkedin} />)}
      </div>
    </section>

    <section class="section">
      <SectionHeader title="What's on" linkHref="/events" linkLabel="All events →" />
      <div class="rows" data-reveal-stagger>
        {recentEvents.map((event) => <EventRow event={event} />)}
      </div>
    </section>

    <!-- Project section - Currently no projects to show -->
    
    <!-- <section class="section">
      <SectionHeader title="What we're building" linkHref="/projects" linkLabel="All projects →" />
      <div class="g2">
        {
          allProjects.map((project) => (
            <ProjectCard
              href={`/projects/${project.id}`}
              title={project.data.title}
              summary={project.data.summary}
              attribution={project.data.lead ? `Lead - ${project.data.lead}` : undefined}
              image={coverOf(project)}
            />
          ))
        }
      </div>
    </section> -->

    <!-- TODO: Podcast section -->

    <JoinCTA />
  </Container>
</Base>

<script>
  import { statusAt } from "../lib/eventStatus";

  // Pick the featured panel by the visitor's date rather than the build's — see
  // the note at the top of this file. Upcoming panels come first, in date order,
  // so the first one not yet over is the next event. If they are all over, the
  // latest recap that is over takes its place.
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-featured]"));
  const statusOfPanel = (panel: HTMLElement) => statusAt(panel.dataset.date ?? "");
  const startOf = (panel: HTMLElement) => new Date(panel.dataset.date ?? "").getTime();

  const choice =
    panels.find((panel) => panel.dataset.featured === "upcoming" && statusOfPanel(panel) !== "past") ??
    panels
      .filter((panel) => panel.dataset.featured === "recap" && statusOfPanel(panel) === "past")
      .sort((a, b) => startOf(b) - startOf(a))[0];

  if (choice) panels.forEach((panel) => (panel.hidden = panel !== choice));
</script>
